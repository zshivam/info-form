# Database Configuration
# Option 1: Full connection string (Recommended for Railway, Supabase, Neon)
DATABASE_URL=postgresql://postgres:password@localhost:5432/info_db

# Option 2: Individual variables (Used if DATABASE_URL is not set)
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=info_db

# Note: If neither is set, local development automatically falls back to SQLite (sql_app.db)

# Optional: Custom CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
