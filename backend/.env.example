# MongoDB Connection String
# For MongoDB Atlas (Free Cloud Cluster):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.yourid.mongodb.net/?retryWrites=true&w=majority

# For Local MongoDB:
MONGODB_URI=mongodb://localhost:27017

# Database Name (optional, defaults to info_form_db)
DB_NAME=info_form_db

# Optional: Custom CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
